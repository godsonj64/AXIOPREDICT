{
  "name": "axio-predict",
  "version": "2.0.1",
  "description": "Cross-platform desktop application for lung cancer risk prediction from low-dose CT scans, powered by the Sybil v1.6.0 deep learning model.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "bash ../setup.sh && electron-builder install-app-deps",
    "dist:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "org.sybil.lung-risk",
    "productName": "AXIO PREDICT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../python_backend",
        "to": "python_backend"
      },
      {
        "from": "../sybil-source",
        "to": "sybil-source"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "lung cancer",
    "risk prediction",
    "low-dose CT",
    "LDCT",
    "DICOM",
    "deep learning",
    "medical imaging",
    "sybil",
    "electron",
    "desktop app",
    "attention maps",
    "clinical decision support"
  ],
  "author": {
    "name": "Godson Johnson",
    "url": "https://github.com/godsonj64"
  },
  "license": "MIT",
  "homepage": "https://github.com/godsonj64/AXIOPREDICT",
  "repository": {
    "type": "git",
    "url": "https://github.com/godsonj64/AXIOPREDICT.git"
  },
  "bugs": {
    "url": "https://github.com/godsonj64/AXIOPREDICT/issues"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
